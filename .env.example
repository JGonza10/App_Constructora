# Clave secreta de Flask (sesiones, CSRF). Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=constructora

# En Railway, la cookie de sesion exige HTTPS (correcto). En local por HTTP,
# ponlo en "false" para poder loguearte sin TLS.
SESSION_COOKIE_SECURE=false

PORT=5000

# Alertas (sobrepresupuesto, pagos de cliente vencidos). Opcional: si no
# configuras ningun canal, la alerta solo queda en el log de la app.
ALERTAS_SMTP_HOST=
ALERTAS_SMTP_PORT=587
ALERTAS_SMTP_USER=
ALERTAS_SMTP_PASSWORD=
ALERTAS_SMTP_FROM=
ALERTAS_EMAIL_DESTINO=
ALERTAS_TELEGRAM_TOKEN=
ALERTAS_TELEGRAM_CHAT_ID=

# Job diario (vencer pagos de cliente atrasados). "false" lo desactiva —
# util si corres varias instancias del proceso web y no quieres duplicados.
SCHEDULER_ENABLED=true
