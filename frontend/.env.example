# En desarrollo local, deja esto vacío o elimina el archivo .env
# (el proxy en package.json redirige /api al backend en localhost:3001)

# En producción (Railway), define la URL pública de tu backend.
# Ojo: Create React App la hornea en el build — si cambia la URL del
# backend hay que reconstruir el frontend, no solo reiniciarlo.
REACT_APP_API_URL=https://tu-backend.up.railway.app
